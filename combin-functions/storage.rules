rules_version = '2';

// Combin Storage rules.
// Photos live at /users/{userId}/photos/{photoId}.jpg and are private to the user.
//
// NOTE: read and write are split deliberately. `request.resource` is only populated
// on writes — referencing `request.resource.size`/`.contentType` on a read would
// evaluate against null and deny legitimate reads (e.g. the wardrobe displaying a
// source photo). So the size/content-type constraints guard writes only; reads are
// gated purely on ownership. (The plan's combined `allow read, write` snippet would
// have broken reads — this is the corrected form.)
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
