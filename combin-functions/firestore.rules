rules_version = '2';

// Combin Firestore rules.
// Every document lives under /users/{userId}/... and is readable/writable only by
// that user. Everything else is denied by the default-deny catch-all at the bottom.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // All per-user subcollections (vibeChecks, wardrobe, usage, tastePreferences…)
      match /{collection}/{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
